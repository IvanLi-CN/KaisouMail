# CLOUDFLARE_RUNTIME_API_TOKEN=replace-with-a-runtime-email-routing-token
# Optional: enable third-party login providers for local auth testing.
# GITHUB_CLIENT_ID=replace-with-your-github-client-id
# GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret
