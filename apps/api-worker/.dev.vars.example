APP_ENV=development
MAIL_DOMAIN=707979.xyz
EMAIL_WORKER_NAME=email-receiver-worker
DEFAULT_MAILBOX_TTL_MINUTES=60
CLEANUP_BATCH_SIZE=3
SUBDOMAIN_CLEANUP_BATCH_SIZE=500
EMAIL_ROUTING_MANAGEMENT_ENABLED=false
BOOTSTRAP_ADMIN_INVITE_CODE=replace-with-a-bootstrap-admin-invite
SESSION_SECRET=replace-with-a-long-random-secret
CLOUDFLARE_ACCOUNT_ID=replace-with-your-account-id
CLOUDFLARE_ZONE_ID=replace-with-your-zone-id
CLOUDFLARE_API_TOKEN=replace-with-an-email-routing-token
